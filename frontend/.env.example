# Raha Frontend Environment Configuration

# Backend API URL (leave blank to use Mock client, or set to your backend server)
# For local development with backend:
EXPO_PUBLIC_API_URL=http://localhost:4000

# MapLibre vector style URL (defaults to OpenFreeMap Liberty style if unset)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
